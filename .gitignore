# Build and test artifacts
/build/
/build-*/
/Log/
**/Log/
/output/*
!/output/.gitkeep
.pytest_cache/
.mypy_cache/
.coverage

# Python environments and caches
/.venv/
/python_deps
__pycache__/
*.py[cod]
*.so

# Local data and recordings
/data/
/recordings/
/record_data/
/third_party/*
!/third_party/README.md
!/third_party/manifest.json
!/third_party/WiLoR
*.mp4
*.avi
*.mov
*.wav

# Downloaded model files are intentionally not redistributed
/models/*.zip
/models/mano/*
!/models/mano/README.md
/models/wilor/*
!/models/wilor/README.md
*.npz

# Editors and operating systems
.DS_Store
._*
.idea/
.vscode/
*.swp
*~

# Local secrets/configuration
.env
.env.*
!.env.example

# Isolated local branches
.worktrees/
